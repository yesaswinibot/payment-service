spring:
  application:
    name: payment-service

  # H2 for local dev (Week 1)
  datasource:
    url: jdbc:h2:mem:paymentdb;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
    driver-class-name: org.h2.Driver
    username: yesaswini
    password: "yesaswinii"

  h2:
    console:
      enabled: true          # Visit http://localhost:8080/h2-console

  jpa:
    hibernate:
      ddl-auto: validate     # Flyway manages schema, not Hibernate
    show-sql: true           # See SQL in console while learning
    properties:
      hibernate:
        format_sql: true
        dialect: org.hibernate.dialect.H2Dialect

  flyway:
    enabled: true
    locations: classpath:db/migration

server:
  port: 8080

management:
  endpoints:
    web:
      exposure:
        include: health,info